  m_text: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\n\n\u041B\u041A\u041C
    / Space \u2014 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0440\u0435\u043F\u043B\u0438\u043A\u0430\nEsc
