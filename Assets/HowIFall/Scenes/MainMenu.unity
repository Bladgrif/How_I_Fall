    \u2014 \u043F\u043E\u043B\u043D\u043E\u044D\u043A\u0440\u0430\u043D\u043D\u044B\u0439
    \u0440\u0435\u0436\u0438\u043C\n\n\u0412 \u0433\u043B\u0430\u0432\u043D\u043E\u043C
    \u043C\u0435\u043D\u044E:\n\n\u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430
    \u2014 \u043D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430\n\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
