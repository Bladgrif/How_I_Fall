  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "How I Fall \u2014 \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u043E\u0432\u0430\u044F
    \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u0430\u044F \u043D\u043E\u0432\u0435\u043B\u043B\u0430
    \u043E \u043D\u0435\u043B\u043E\u0432\u043A\u0438\u0445 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0445,
    \u0448\u043A\u043E\u043B\u044C\u043D\u044B\u0445 \u0442\u0430\u0439\u043D\u0430\u0445
    \u0438 \u0432\u044B\u0431\u043E\u0440\u0435, \u043F\u043E\u0441\u043B\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0443\u0436\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u0440\u0438\u0442\u0432\u043E\u0440\u044F\u0442\u044C\u0441\u044F
    \u043F\u0440\u0435\u0436\u043D\u0438\u043C.\n\n\u0416\u0430\u043D\u0440: \u0448\u043A\u043E\u043B\u044C\u043D\u0430\u044F
    \u0434\u0440\u0430\u043C\u0430, \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u043A\u0430,
    \u043B\u0451\u0433\u043A\u0430\u044F \u043C\u0438\u0441\u0442\u0438\u043A\u0430,
    \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432.\n\u0412\u0435\u0440\u0441\u0438\u044F:
    In Development"
