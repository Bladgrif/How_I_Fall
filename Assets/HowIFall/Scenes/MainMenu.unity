  m_text: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\n\n\u041B\u041A\u041C
    / Space \u2014 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0440\u0435\u043F\u043B\u0438\u043A\u0430\nEsc
    \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043E\u043A\u043D\u043E \u0438\u043B\u0438
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430\u0437\u0430\u0434\nH
    \u2014 \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0440\u0435\u043F\u043B\u0438\u043A\nCtrl
    \u2014 \u043F\u0440\u043E\u043F\u0443\u0441\u043A \u0442\u0435\u043A\u0441\u0442\u0430\nF
    \u2014 \u043F\u043E\u043B\u043D\u043E\u044D\u043A\u0440\u0430\u043D\u043D\u044B\u0439
    \u0440\u0435\u0436\u0438\u043C\n\n\u0412 \u0433\u043B\u0430\u0432\u043D\u043E\u043C
    \u043C\u0435\u043D\u044E:\n\n\u041D\u0430\u0447\u0430\u0442\u044C \u2014 \u043D\u043E\u0432\u0430\u044F
    \u0438\u0433\u0440\u0430\n\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
    \u2014 \u044D\u043A\u0440\u0430\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0439\n\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u2014 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0438\u0433\u0440\u044B"
