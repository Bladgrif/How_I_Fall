  sceneId: classroom_first_lesson
  lines:
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 0
    speaker: 
    text: "\u041A\u043B\u0430\u0441\u0441 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u043C\u0435\u043D\u044F \u0433\u0443\u043B\u043E\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u0432 \u0438 \u0441\u043A\u0440\u0438\u043F\u043E\u043C \u0441\u0442\u0443\u043B\u044C\u0435\u0432."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 0
    speaker: "\u0410\u0440\u0442\u0451\u043C"
    text: "\u0421\u043C\u043E\u0442\u0440\u0438-\u043A\u0430, \u0436\u0438\u0432\u043E\u0439. \u042F \u0443\u0436\u0435 \u0434\u0443\u043C\u0430\u043B, \u0442\u0435\u0431\u044F \u0432\u0447\u0435\u0440\u0430 \u0443\u0442\u0430\u0449\u0438\u043B\u0438 \u0434\u0443\u0445\u0438 \u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0439 \u0434\u0438\u0441\u043A\u043E\u0442\u0435\u043A\u0438."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 0
    speaker: 
    text: "\u041E\u043D \u0441\u043C\u0435\u0451\u0442\u0441\u044F, \u043D\u043E \u044F \u0437\u0430\u043C\u0435\u0447\u0430\u044E: \u0441\u0430\u043C \u043E\u043D \u0442\u043E\u0436\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0432\u044B\u0441\u043F\u0430\u0432\u0448\u0438\u043C\u0441\u044F."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 0
    speaker: "\u041C\u0430\u0448\u0430"
    text: "\u0410\u0440\u0442\u0451\u043C, \u043D\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0439."
  choices: []
  defaultNextScene: {fileID: 0}
