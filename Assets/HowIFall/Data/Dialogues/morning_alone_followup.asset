  m_Script: {fileID: 11500000, guid: d339ace56c47e2b4794195ab024267da, type: 3}
  m_Name: morning_alone_followup
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSceneData
  sceneId: morning_alone_followup
  backgroundMusic: {fileID: 0}
  stopMusicOnStart: 0
  lines:
  - background: {fileID: 21300000, guid: 1760e6cceb43319449c6e14471d0ec4c, type: 3}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: 
    text: "\u042F \u043E\u0442\u043E\u0448\u0451\u043B \u043A \u043E\u043A\u043D\u0443
      \u0438 \u0441\u0434\u0435\u043B\u0430\u043B \u0432\u0438\u0434, \u0447\u0442\u043E
      \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u042D\u043A\u0440\u0430\u043D
      \u0431\u044B\u043B \u0447\u0451\u0440\u043D\u044B\u043C, \u0445\u043E\u0442\u044F
      \u0431\u0430\u0442\u0430\u0440\u0435\u044F \u0435\u0449\u0451 \u0443\u0442\u0440\u043E\u043C
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0437\u0430\u0440\u044F\u0434\u0430."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: "\u042F"
    text: "\u0412 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0438 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0431\u044B\u043B \u0434\u043B\u0438\u043D\u043D\u0435\u0435, \u0447\u0435\u043C
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435. \u0414\u0432\u0435\u0440\u044C
      \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u043C\u0443\u0437\u044B\u043A\u0438
      \u0442\u0430\u043C \u0441\u0442\u043E\u044F\u043B\u0430 \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: ac92b248ebc42844486d0f634c520ed4, type: 3}
    characterPosition: 2
    hideCharacter: 0
    speaker: "\u041B\u0435\u0440\u0430"
    text: "\u0415\u0441\u043B\u0438 \u0431\u0443\u0434\u0435\u0448\u044C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E,
      \u043E\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u0442, \u0447\u0442\u043E
      \u0442\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: ac92b248ebc42844486d0f634c520ed4, type: 3}
    characterPosition: 2
    hideCharacter: 0
    speaker: "\u042F"
    text: "\u042F \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u043D\u043E
      \u041B\u0435\u0440\u0430 \u0443\u0436\u0435 \u0448\u043B\u0430 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0415\u0451 \u0433\u043E\u043B\u043E\u0441 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439, \u043A\u0430\u043A
      \u0445\u043E\u043B\u043E\u0434 \u043D\u0430 \u0441\u0442\u0435\u043A\u043B\u0435."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: 
    text: "\u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0437\u0432\u0435\u043D\u0435\u043B
      \u0437\u0432\u043E\u043D\u043E\u043A, \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0432 \u043E\u043A\u043D\u0435 \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u043E\u0441\u044C
      \u043D\u0430 \u0434\u043E\u043B\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u043F\u043E\u0437\u0436\u0435 \u043C\u0435\u043D\u044F."
  choices: []
  defaultNextScene: {fileID: 11400000, guid: c6079a892768944498b9aec57340b7cb, type: 2}
