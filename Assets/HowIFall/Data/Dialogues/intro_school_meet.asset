  m_Script: {fileID: 11500000, guid: d339ace56c47e2b4794195ab024267da, type: 3}
  m_Name: intro_school_meet
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSceneData
  sceneId: intro_school_meet
  lines:
  - background: {fileID: 21300000, guid: e8417122968e3e34386e43696e4d57fe, type: 3}
    characterSprite: {fileID: 21300000, guid: c72e8a465be637b429daf75364bf3a5d, type: 3}
    characterPosition: 3
    hideCharacter: 0
    speaker: 
    text: "\u0423\u0442\u0440\u043E \u0443 \u0448\u043A\u043E\u043B\u044C\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u043F\u0430\u0445\u043D\u0435\u0442 \u043C\u043E\u043A\u0440\u044B\u043C
      \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u043E\u043C \u0438 \u0447\u0435\u043C-\u0442\u043E
      \u0441\u043B\u0430\u0434\u043A\u0438\u043C \u0438\u0437 \u043A\u0438\u043E\u0441\u043A\u0430
      \u0447\u0435\u0440\u0435\u0437 \u0434\u043E\u0440\u043E\u0433\u0443."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: c72e8a465be637b429daf75364bf3a5d, type: 3}
    characterPosition: 3
    hideCharacter: 0
    speaker: "\u041C\u0430\u0448\u0430"
    text: "\u0422\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043F\u0440\u0438\u0448\u0451\u043B."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 0
    speaker: 
    text: "\u041C\u0430\u0448\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442,
      \u043D\u0435 \u0438\u0441\u0447\u0435\u0437\u043D\u0443 \u043B\u0438 \u044F
      \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: c72e8a465be637b429daf75364bf3a5d, type: 3}
    characterPosition: 3
    hideCharacter: 0
    speaker: "\u041C\u0430\u0448\u0430"
    text: "\u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u043F\u043E\u0441\u043B\u0435
      \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0439 \u0432\u0435\u0447\u0435\u0440\u0438\u043D\u043A\u0438
      \u0442\u044B \u043F\u0440\u043E\u0441\u043F\u0438\u0448\u044C \u043F\u0435\u0440\u0432\u044B\u0439
      \u0443\u0440\u043E\u043A."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 0
    speaker: 
    text: "\u042F \u0445\u043E\u0442\u0435\u043B \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C
      \u0448\u0443\u0442\u043A\u043E\u0439, \u043D\u043E \u0432 \u043F\u0430\u043C\u044F\u0442\u0438
      \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0440\u0443\u0433 \u0441\u0432\u0435\u0447\u0435\u0439 \u0438 \u0447\u0435\u0439-\u0442\u043E
      \u0442\u0438\u0445\u0438\u0439 \u0441\u043C\u0435\u0445."
  choices:
  - text: "\u041E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u041C\u0430\u0448\u0435
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E"
    resultText: "\u042F \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C
      \u043A \u041C\u0430\u0448\u0435 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044E
      \u0441\u0435\u0431\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0440\u043E\u0432\u043D\u043E."
    lustDelta: 0
    romanceDelta: 1
    purityDelta: 0
    corruptionDelta: 0
    selfControlDelta: 1
    suspicionDelta: 0
    trustMashaDelta: 1
    trustArtemDelta: 0
    leraInterestDelta: 0
    nextScene: {fileID: 0}
  - text: "\u041F\u043E\u0434\u044B\u0433\u0440\u0430\u0442\u044C \u0410\u0440\u0442\u0451\u043C\u0443"
    resultText: "\u0415\u0441\u043B\u0438 \u0443 \u0410\u0440\u0442\u0451\u043C\u0430
      \u0435\u0441\u0442\u044C \u043F\u043B\u0430\u043D \u043F\u043E\u0431\u0435\u0433\u0430,
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443."
    lustDelta: 1
    romanceDelta: 0
    purityDelta: 0
    corruptionDelta: 0
    selfControlDelta: -1
    suspicionDelta: 0
    trustMashaDelta: 0
    trustArtemDelta: 1
    leraInterestDelta: 0
    nextScene: {fileID: 0}
  - text: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u043E \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0438\u0439
      \u0440\u0438\u0442\u0443\u0430\u043B"
    resultText: "\u042F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0434\u0443\u043C\u0430\u044E
      \u043E \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u043C \u0440\u0438\u0442\u0443\u0430\u043B\u0435.
      \u0418 \u044D\u0442\u043E \u043F\u0443\u0433\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
      \u0447\u0435\u043C \u0434\u043E\u043B\u0436\u043D\u043E."
    lustDelta: 0
    romanceDelta: 0
    purityDelta: 1
    corruptionDelta: 0
    selfControlDelta: 0
