  lines:
  - lineId: ui_intro
    background: {fileID: 21300000, guid: 951bfc3459c74263b987d70c2efc7c27, type: 3}
    characterSprite: {fileID: 21300000, guid: 7ec46cc252b048f3b96e70247b5c7e47, type: 3}
    characterPosition: 0
    hideCharacter: 0
    speaker: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    text: "\u042D\u0442\u043E \u0442\u0435\u0441\u0442\u043E\u0432\u0430\u044F \u0441\u0446\u0435\u043D\u0430
      \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430. \u0417\u0434\u0435\u0441\u044C
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043E\u043A\u043D\u043E
      \u0434\u0438\u0430\u043B\u043E\u0433\u0430, \u0438\u043C\u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
      \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0435 \u043A\u043D\u043E\u043F\u043A\u0438."
  - lineId: ui_story_placeholder
    background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: 7ec46cc252b048f3b96e70247b5c7e47, type: 3}
    characterPosition: 0
    hideCharacter: 0
    speaker: "\u042F"
    text: "\u0421\u044E\u0436\u0435\u0442\u043D\u044B\u0435 \u0440\u0435\u043F\u043B\u0438\u043A\u0438
      \u0438 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438
      \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u044B
      \u043F\u043E\u0437\u0436\u0435."
  - lineId: ui_visual_setup
    background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: 7ec46cc252b048f3b96e70247b5c7e47, type: 3}
    characterPosition: 0
    hideCharacter: 0
    speaker: 
    text: "\u041F\u043E\u043A\u0430 \u044D\u0442\u0430 \u0441\u0446\u0435\u043D\u0430
      \u043D\u0443\u0436\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430."
  choices:
  - text: "\u041E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E"
    resultText: "\u0412\u044B\u0431\u043E\u0440 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D.
      \u042D\u0442\u043E \u0442\u0435\u0441\u0442\u043E\u0432\u0430\u044F \u0432\u0435\u0442\u043A\u0430
      \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430."
