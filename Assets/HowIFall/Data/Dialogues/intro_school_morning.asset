  - text: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u0434\u043D\u043E\u043C\u0443"
    resultText: "\u042F \u043E\u0442\u043E\u0448\u0451\u043B \u043A \u043E\u043A\u043D\u0443
      \u0438 \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u043C\u044B\u0441\u043B\u0438. \u0412 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0438
      \u0437\u0430 \u043C\u043E\u0435\u0439 \u0441\u043F\u0438\u043D\u043E\u0439
      \u043D\u0430 \u043C\u0438\u0433 \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
      \u0435\u0449\u0451 \u043E\u0434\u043D\u0430 \u0444\u0438\u0433\u0443\u0440\u0430."
