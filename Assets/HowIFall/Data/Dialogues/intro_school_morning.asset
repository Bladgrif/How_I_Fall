  m_Script: {fileID: 11500000, guid: d339ace56c47e2b4794195ab024267da, type: 3}
  m_Name: intro_school_morning
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSceneData
  sceneId: intro_school_morning
  backgroundMusic: {fileID: 0}
  stopMusicOnStart: 0
  lines:
  - background: {fileID: 21300000, guid: e8417122968e3e34386e43696e4d57fe, type: 3}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: 
    text: "\u0423\u0442\u0440\u043E \u0443 \u0448\u043A\u043E\u043B\u044C\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0431\u044B\u043B\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u0438\u0445\u0438\u043C \u0434\u043B\u044F \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A\u0430.
      \u0414\u0430\u0436\u0435 \u0432\u043E\u0440\u043E\u043D\u044B \u043D\u0430
      \u043F\u0440\u043E\u0432\u043E\u0434\u0430\u0445 \u0441\u0438\u0434\u0435\u043B\u0438
      \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0436\u0434\u0430\u043B\u0438
      \u0437\u0432\u043E\u043D\u043A\u0430 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E
      \u043C\u043D\u043E\u0439."
  - background: {fileID: 21300000, guid: e8417122968e3e34386e43696e4d57fe, type: 3}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: "\u042F"
    text: "\u042F \u043F\u0440\u0438\u0448\u0451\u043B \u0440\u0430\u043D\u044C\u0448\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E, \u0445\u043E\u0442\u044F
      \u0431\u0443\u0434\u0438\u043B\u044C\u043D\u0438\u043A \u0441\u043D\u043E\u0432\u0430
      \u043D\u0435 \u043F\u0440\u043E\u0437\u0432\u0435\u043D\u0435\u043B. \u041D\u0430
      \u044D\u043A\u0440\u0430\u043D\u0435 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430
      \u043C\u0438\u0433\u0430\u043B\u043E \u0432\u0440\u0435\u043C\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0442\u0430\u043C \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0431\u044B\u0442\u044C: 07:07."
  - background: {fileID: 21300000, guid: 30b25cf817d5279449c00a47ccbcc883, type: 3}
    characterSprite: {fileID: 21300000, guid: c72e8a465be637b429daf75364bf3a5d, type: 3}
    characterPosition: 0
    hideCharacter: 0
    speaker: "\u041C\u0430\u0448\u0430"
    text: "\u0422\u044B \u0442\u043E\u0436\u0435 \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B?
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0435 \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u0442\u0438\u0448\u0435."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: c72e8a465be637b429daf75364bf3a5d, type: 3}
    characterPosition: 0
    hideCharacter: 0
    speaker: "\u042F"
    text: "\u041C\u0430\u0448\u0430 \u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044C
      \u0443\u043B\u044B\u0431\u0430\u0442\u044C\u0441\u044F, \u043D\u043E \u043F\u0430\u043B\u044C\u0446\u044B
      \u043A\u0440\u0435\u043F\u043A\u043E \u0441\u0436\u0438\u043C\u0430\u043B\u0438
      \u0440\u0435\u043C\u0435\u0448\u043E\u043A \u043F\u043E\u0440\u0442\u0444\u0435\u043B\u044F.
      \u041E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0430\u043A
      \u0434\u0435\u043B\u0430\u043B\u0430, \u043A\u043E\u0433\u0434\u0430 \u0431\u043E\u044F\u043B\u0430\u0441\u044C
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0442\u0440\u0430\u0445."
  - background: {fileID: 21300000, guid: 1760e6cceb43319449c6e14471d0ec4c, type: 3}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: 
    text: "\u0412 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435 \u043F\u0430\u0445\u043B\u043E
      \u043C\u0435\u043B\u043E\u043C, \u043C\u043E\u043A\u0440\u043E\u0439 \u0444\u043E\u0440\u043C\u043E\u0439
      \u0438 \u0447\u0435\u043C-\u0442\u043E \u0441\u043B\u0430\u0434\u043A\u0438\u043C,
      \u043A\u0430\u043A \u0434\u0443\u0445\u0438 \u0438\u0437 \u0447\u0443\u0436\u043E\u0433\u043E
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F. \u0421\u0432\u0435\u0442
      \u043D\u0430\u0434 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435\u0439 \u043C\u0438\u0433\u043D\u0443\u043B
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: ce72060c44be2b04c8d0cb9252671fc7, type: 3}
    characterPosition: 2
    hideCharacter: 0
    speaker: "\u0410\u0440\u0442\u0451\u043C"
    text: "\u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u0430\u044F
      \u0448\u043A\u043E\u043B\u044C\u043D\u0430\u044F \u043B\u0435\u0433\u0435\u043D\u0434\u0430,
      \u0442\u043E \u043E\u043D\u0430 \u0432\u044B\u0431\u0440\u0430\u043B\u0430
      \u043E\u0447\u0435\u043D\u044C \u0441\u043A\u0443\u0447\u043D\u043E\u0435 \u0443\u0442\u0440\u043E
      \u0434\u043B\u044F \u0434\u0435\u0431\u044E\u0442\u0430."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: ce72060c44be2b04c8d0cb9252671fc7, type: 3}
    characterPosition: 2
    hideCharacter: 0
    speaker: "\u042F"
    text: "\u0410\u0440\u0442\u0451\u043C \u0441\u043A\u0430\u0437\u0430\u043B \u044D\u0442\u043E
      \u043B\u0435\u0433\u043A\u043E, \u043F\u043E\u0447\u0442\u0438 \u0432\u0435\u0441\u0435\u043B\u043E.
      \u041D\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0443 \u043D\u0435\u0433\u043E
      \u0431\u044B\u043B \u043D\u0435 \u043D\u0430 \u043D\u0430\u0441, \u0430 \u043D\u0430
      \u043F\u0443\u0441\u0442\u0443\u044E \u0434\u0432\u0435\u0440\u044C \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430
      \u043C\u0443\u0437\u044B\u043A\u0438."
  - background: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: ac92b248ebc42844486d0f634c520ed4, type: 3}
    characterPosition: 1
    hideCharacter: 0
    speaker: "\u041B\u0435\u0440\u0430"
    text: "\u041D\u0435 \u0441\u0442\u043E\u0439\u0442\u0435 \u0437\u0434\u0435\u0441\u044C.
      \u0423\u0447\u0438\u0442\u0435\u043B\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043D\u0435 \u043B\u044E\u0431\u044F\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: 
    text: "\u041E\u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u0430 \u043C\u0438\u043C\u043E,
      \u043D\u0435 \u043E\u0433\u043B\u044F\u043D\u0443\u0432\u0448\u0438\u0441\u044C.
      \u041D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043C\u043D\u0435
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
      \u0435\u0451 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0432
      \u043E\u043A\u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u043E\u0441\u044C
      \u0434\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u043D\u0430
      \u0441\u0430\u043C\u0430."
  - background: {fileID: 0}
    characterSprite: {fileID: 0}
    characterPosition: 1
    hideCharacter: 1
    speaker: 
    text: "\u0414\u043E \u0437\u0432\u043E\u043D\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0430\u0441\u044C
      \u043C\u0438\u043D\u0443\u0442\u0430. \u041C\u0430\u0448\u0430 \u0436\u0434\u0430\u043B\u0430
      \u043E\u0442\u0432\u0435\u0442\u0430, \u0410\u0440\u0442\u0451\u043C \u0434\u0435\u043B\u0430\u043B
      \u0432\u0438\u0434, \u0447\u0442\u043E \u0435\u043C\u0443 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E, \u0430 \u0448\u043A\u043E\u043B\u0430 \u0432\u043E\u043A\u0440\u0443\u0433
      \u043D\u0430\u0441 \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u043B\u0430\u0441\u044C."
  choices:
  - text: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u041C\u0430\u0448\u0435"
    resultText: "\u042F \u0441\u0434\u0435\u043B\u0430\u043B \u0448\u0430\u0433 \u043A
      \u041C\u0430\u0448\u0435. \u041E\u043D\u0430 \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0430
      \u0442\u0430\u043A \u0442\u0438\u0445\u043E, \u0431\u0443\u0434\u0442\u043E
      \u0432\u0441\u0451 \u0443\u0442\u0440\u043E \u0436\u0434\u0430\u043B\u0430
      \u0438\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u043E\u0433\u043E."
    lustDelta: 0
    romanceDelta: 1
    purityDelta: 0
    corruptionDelta: 0
    selfControlDelta: 1
    suspicionDelta: 0
    trustMashaDelta: 1
    trustArtemDelta: 0
    leraInterestDelta: 0
    nextScene: {fileID: 11400000, guid: 31d9984441d080d4ab05ab1703b3f381, type: 2}
  - text: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441 \u0410\u0440\u0442\u0451\u043C\u043E\u043C"
    resultText: "\u042F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043A \u0410\u0440\u0442\u0451\u043C\u0443. \u0415\u0433\u043E \u0448\u0443\u0442\u043B\u0438\u0432\u0430\u044F
      \u0443\u043B\u044B\u0431\u043A\u0430 \u0434\u0440\u043E\u0433\u043D\u0443\u043B\u0430,
      \u0438 \u043E\u043D \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u043C\u0435\u043D\u044F \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E."
    lustDelta: 0
