# Вы можете расположить сценарий своей игры в этом файле.

# Определение персонажей для технической проверки UI.
define p = Character(None)
define m = Character("Маша")
define a = Character("Артём")
define l = Character("Лера")
define v = Character("Голос")


# Игра начинается здесь:
label start:

    # TODO: позже заменить на фон школьного коридора.
    scene black

    p "Я просыпаюсь от резкого звона, хотя не помню, чтобы ложился."

    p "Перед глазами медленно собирается школьный коридор: тусклый свет, мокрые следы на полу и чужие голоса за стеной."

    m "Ты опять стоишь и молчишь. Всё нормально?"

    p "Маша смотрит так, будто уже знает ответ."

    m "У тебя лицо такое, словно ты видел сон, который не закончился."

    a "Или контрольную по алгебре. Иногда это почти одно и то же."

    m "Артём."

    a "Что? Я пытаюсь разрядить атмосферу. Она тут плотнее, чем воздух в раздевалке после физры."

    p "Я хочу улыбнуться, но в груди тянет холодом."

    l "Вы слышали звонок?"

    p "Лера появляется у окна. Спокойная, слишком спокойная, будто стояла там всё это время."

    m "Лера? Ты откуда взялась?"

    l "Оттуда же, откуда и он."

    a "Это должно было прозвучать загадочно или я просто не выспался?"

    v "Не слушай их."

    p "Голос звучит не снаружи. Он касается мыслей мягко, почти ласково."

    v "Сделай шаг. Позволь этому чувству стать твоим."

    m "Эй. Посмотри на меня. Что ты слышишь?"

    menu:

        "Поддаться ощущению":
            p "Я позволяю холоду подняться выше, и коридор на секунду становится не школьным, а бесконечным."
            v "Вот так. Ты почти вспомнил."
            jump test_scene_end

        "Спросить Машу":
            p "Я делаю вдох и цепляюсь за Машин голос."
            m "Хорошо. Не отворачивайся. Просто скажи, что происходит."
            jump test_scene_end

        "Оттолкнуть голос":
            p "Я сжимаю пальцы и мысленно отталкиваю чужое присутствие."
            v "Ты можешь сопротивляться. Но ты всё равно услышал меня."
            jump test_scene_end

label test_scene_end:

    l "Звонок повторится через минуту."

    a "Отлично. Тогда у нас целая минута, чтобы решить, насколько всё плохо."

    m "Пойдём. Только держись рядом."

    p "Я киваю, хотя коридор за её плечом снова кажется слишком длинным."

    return
